        FrameWidgetClass TankPanel {
            position 0 -120
            size 320 82
            halign center_ref
            valign bottom_ref
            hexactpos 1
            vexactpos 1
            hexactsize 1
            vexactsize 1
            ignorepointer 1
            {
                PanelWidgetClass BarBg {
                    position 0.05 0.42
                    size 0.90 0.30
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    ignorepointer 1
                    color 0.12 0.12 0.12 0.90
                    style rover_sim_colorable
                }
                PanelWidgetClass BarFill {
                    position 0.05 0.42
                    size 0.90 0.30
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    ignorepointer 1
                    color 0.20 0.60 1.00 0.86
                    style rover_sim_colorable
                }
                TextWidgetClass TankText {
                    position 0.05 0.05
                    size 0.62 0.30
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
                    ignorepointer 1
                    font "gui/fonts/Metron"
                    "text halign" left
                    "text valign" center
                    text "0L / 0L (0%)"
                }
                TextWidgetClass StatusText {
                    position 0.68 0.05
                    size 0.27 0.30
                    hexactpos 0
                    vexactpos 0
                    hexactsize 0
                    vexactsize 0
